# ── Required ──────────────────────────────────────────────────────────────
# Auth.js session encryption. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Spotify app credentials (developer.spotify.com/dashboard).
# Redirect URI: <your-origin>/api/auth/callback/spotify
# Locally, Spotify requires a loopback IP: http://127.0.0.1:3000/api/auth/callback/spotify
AUTH_SPOTIFY_ID=
AUTH_SPOTIFY_SECRET=

# Claude API key (console.anthropic.com). Use a workspace-scoped key.
ANTHROPIC_API_KEY=
# Only if your key is NOT scoped to a workspace:
# ANTHROPIC_WORKSPACE_ID=

# ── Rate limiting (required in production for the public upload flow) ────
# Upstash Redis REST credentials. The Vercel Marketplace integration may set
# KV_REST_API_URL / KV_REST_API_TOKEN instead; either pair works.
# Without Redis, limits are skipped in development and anonymous curation is
# refused in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Optional tuning ───────────────────────────────────────────────────────
# CURATE_LIMIT_PUBLIC=3      # curations per IP per day, upload flow
# CURATE_LIMIT_SPOTIFY=20    # curations per IP per day, signed-in flow
# CURATE_LIMIT_GLOBAL=300    # curations per day across everyone
# CURATION_ENABLED=false     # kill switch for the Claude-backed step
